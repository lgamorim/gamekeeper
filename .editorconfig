root = true

# All files
[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# --- Language conventions (coding-standards.md) ------------------------------------------------

# File-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:warning

# 'var' when the type is apparent.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_elsewhere = false:silent

# Prefer pattern matching over type checks/casts.
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_pattern_matching = true:suggestion

# Expression-bodied members: allowed but never required (used only when they improve readability).
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent

# readonly where possible.
dotnet_style_readonly_field = true:warning

# Unused usings and unnecessary code fail the build (coding-standards.md calls out IDE0005).
dotnet_diagnostic.IDE0005.severity = warning

# --- Naming rules ------------------------------------------------------------------------------

# Interfaces are PascalCase with an 'I' prefix.
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed_pascal_case
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.i_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed_pascal_case.required_prefix = I

# Types and non-field members are PascalCase.
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_rule.members_are_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_symbols.member_symbols.applicable_kinds = method, property, event
dotnet_naming_symbols.member_symbols.applicable_accessibilities = *

# Constants (fields and locals) and static readonly (constant-like) values are PascalCase.
# Listed before the parameter/local rule below so a local const is matched here, not there.
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.constants_are_pascal_case.symbols = constant_symbols
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_symbols.constant_symbols.applicable_kinds = field, local
dotnet_naming_symbols.constant_symbols.applicable_accessibilities = *
dotnet_naming_symbols.constant_symbols.required_modifiers = const

dotnet_naming_rule.static_readonly_are_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_are_pascal_case.symbols = static_readonly_symbols
dotnet_naming_rule.static_readonly_are_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_symbols.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_symbols.required_modifiers = static, readonly

# Private instance fields are _camelCase.
dotnet_naming_rule.private_fields_are_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_camel_case.symbols = private_field_symbols
dotnet_naming_rule.private_fields_are_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Parameters and locals are camelCase.
dotnet_naming_rule.parameters_are_camel_case.severity = warning
dotnet_naming_rule.parameters_are_camel_case.symbols = parameter_local_symbols
dotnet_naming_rule.parameters_are_camel_case.style = camel_case
dotnet_naming_symbols.parameter_local_symbols.applicable_kinds = parameter, local
dotnet_naming_symbols.parameter_local_symbols.applicable_accessibilities = *
dotnet_naming_style.camel_case.capitalization = camel_case
